{
  "name": "smartscan-x-pro",
  "productName": "SmartScan X Pro",
  "version": "5.0.0",
  "description": "SmartScan X Pro - local-first intelligent file relationship scanner with offline multi-user accounts and a fun game center",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node start-dev.cjs",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1",
    "@supabase/supabase-js": "^2.57.0"
  },
  "devDependencies": {},
  "build": {
    "appId": "com.smartscanx.pro",
    "productName": "SmartScan X Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/smartscan-x.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}